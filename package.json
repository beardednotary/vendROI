{
  "name": "vending-roi-calculator",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "npx tsc --noEmit",
    "typecheck:website": "npm --prefix website run typecheck",
    "lint:mobile": "eslint App.tsx src tests --ext .ts,.tsx,.js",
    "lint": "npm run lint:mobile && npm --prefix website run lint",
    "test:smoke-premium": "node tests/premium-gate-smoke.js",
    "test:calculations": "npx tsc -p tsconfig.test.json && node .test-build/tests/calculations.test.js",
    "test": "npm run test:calculations && npm run test:smoke-premium"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "date-fns": "^3.0.6",
    "expo": "^54.0.25",
    "expo-file-system": "~19.0.19",
    "expo-image-picker": "~17.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.15",
    "expo-sharing": "~14.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.7.1",
    "react-native-purchases-ui": "^9.7.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "^0.6.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@eslint/js": "^9.39.3",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
